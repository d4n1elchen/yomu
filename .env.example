# Copy to .env.local and fill in. .env.local is gitignored.
#
# Never prefix any of these with NEXT_PUBLIC_. Next.js inlines NEXT_PUBLIC_
# variables into the client bundle at build time, which would publish the key
# to every visitor — and the only fix after that is rotating it.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- LLM provider -----------------------------------------------------------
# Which provider answers questions about a sentence. Ollama needs no key.
YOMU_LLM_PROVIDER=ollama

# Base URL of the Ollama host. Defaults to http://127.0.0.1:11434.
YOMU_OLLAMA_URL=

# This machine's LAN address, so Next will serve its dev chunks when the app is
# opened from a phone on the same network instead of returning 403 for its own
# client bundle -- which looks exactly like broken React. Comma-separate more
# than one. Leave blank if you only ever open the app on localhost.
YOMU_DEV_ORIGIN=

# Models to try in order, comma-separated; the first that answers wins, and one
# that fails is skipped for a minute. Left blank, the app uses this same list.
# A cloud model (the :cloud suffix) needs `ollama signin` on the Ollama host.
# qwen3.8:27b is the measured local model: accurate Traditional Chinese and
# correct grammar analysis. Smaller local models (9B) mangle conjugations
# badly enough to teach the wrong thing. YOMU_LLM_MODEL is no longer read.
YOMU_LLM_MODELS=glm-5.3-flash:cloud,qwen3.8:27b

# --- deployment -------------------------------------------------------------
# Read by scripts/deploy.sh, not by the app: they become -H and -p on the
# systemd unit's ExecStart line. Set them here rather than on the command line,
# because the unit is regenerated on every deploy and a value passed once would
# revert to the default on the next plain `npm run deploy`.

# 0.0.0.0 so other devices on the network can reach it; 127.0.0.1 to keep it on
# this machine only.
YOMU_HOST=0.0.0.0
YOMU_PORT=3000

# The systemd unit's name: systemctl --user status <this>.
YOMU_SERVICE=yomu
